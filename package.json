{
  "name": "task-management-system-root",
  "version": "1.0.0",
  "description": "Full-Stack Task Management System inspired by Trello",
  "private": true,
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:server": "npm --prefix backend install",
    "install:client": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build",
    "build:client": "npm --prefix frontend run build"
  },
  "keywords": [
    "task-manager",
    "kanban",
    "express",
    "mongodb",
    "react"
  ],
